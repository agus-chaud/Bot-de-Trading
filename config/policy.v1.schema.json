{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/bot-trading/config/policy.v1.schema.json",
  "title": "Bot de Trading policy config v1",
  "description": "Esquema para config/policy.v1.yaml (paper-first, perfil moderado).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "weights",
    "geo",
    "short_kill_switch_monthly_dd",
    "cadence",
    "execution_mode",
    "symbols",
    "risk",
    "long_term_engine",
    "short_term_engine",
    "markets",
    "logging",
    "data_providers",
    "calendar",
    "corporate_actions",
    "validation_wf"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profile": {
      "type": "string",
      "enum": ["moderate"]
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["short", "long"],
      "properties": {
        "short": { "type": "number", "minimum": 0, "maximum": 1 },
        "long": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AR", "US"],
      "properties": {
        "AR": { "type": "number", "minimum": 0, "maximum": 1 },
        "US": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "short_kill_switch_monthly_dd": {
      "type": "number",
      "maximum": 0,
      "description": "Drawdown mensual del bucket corto que dispara kill switch (típicamente negativo, ej. -0.08)."
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["short", "long"],
      "properties": {
        "short": { "type": "string", "enum": ["daily"] },
        "long": { "type": "string", "enum": ["monthly"] }
      }
    },
    "execution_mode": {
      "type": "string",
      "enum": ["semi_auto", "auto"]
    },
    "symbols": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "whitelist_us_file",
        "whitelist_ar_file",
        "inline_us",
        "inline_ar"
      ],
      "properties": {
        "whitelist_us_file": { "type": "string", "minLength": 1 },
        "whitelist_ar_file": { "type": "string", "minLength": 1 },
        "inline_us": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inline_ar": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_notional_per_ticker_pct",
        "max_sector_pct",
        "max_daily_loss_short_pct",
        "max_daily_loss_long_pct",
        "max_daily_loss_total_pct",
        "max_monthly_loss_short_pct",
        "max_monthly_loss_long_pct",
        "max_monthly_loss_total_pct",
        "no_trade_first_minutes",
        "no_trade_last_minutes",
        "news_window_enabled",
        "halt_on_data_quality",
        "adv_min_shares_day",
        "short_kill_switch_until"
      ],
      "properties": {
        "max_notional_per_ticker_pct": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_sector_pct": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_daily_loss_short_pct": { "type": "number", "maximum": 0 },
        "max_daily_loss_long_pct": { "type": "number", "maximum": 0 },
        "max_daily_loss_total_pct": { "type": "number", "maximum": 0 },
        "max_monthly_loss_short_pct": { "type": "number", "maximum": 0 },
        "max_monthly_loss_long_pct": { "type": "number", "maximum": 0 },
        "max_monthly_loss_total_pct": { "type": "number", "maximum": 0 },
        "no_trade_first_minutes": { "type": "integer", "minimum": 0 },
        "no_trade_last_minutes": { "type": "integer", "minimum": 0 },
        "news_window_enabled": { "type": "boolean" },
        "halt_on_data_quality": { "type": "boolean" },
        "adv_min_shares_day": { "type": "number", "minimum": 0 },
        "short_kill_switch_until": {
          "type": "string",
          "enum": ["manual_reset", "month_end"]
        },
        "stop_loss": {
          "type": "object",
          "additionalProperties": false,
          "required": ["atr_multiplier", "atr_lookback", "fallback_pct_us", "fallback_pct_ar"],
          "properties": {
            "atr_multiplier": { "type": "number", "exclusiveMinimum": 0 },
            "atr_lookback": { "type": "integer", "minimum": 1 },
            "fallback_pct_us": { "type": "number", "maximum": 0 },
            "fallback_pct_ar": { "type": "number", "maximum": 0 }
          }
        }
      }
    },
    "long_term_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drift_rebalance_threshold_pp",
        "drift_convention",
        "rebalance_rule",
        "max_long_rebalance_turnover_pct",
        "satellite_markets",
        "core_lines",
        "satellite_lines",
        "satellite_limits"
      ],
      "properties": {
        "drift_rebalance_threshold_pp": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Umbral de drift por línea en puntos porcentuales (pp)."
        },
        "drift_convention": {
          "type": "string",
          "enum": ["per_line"],
          "description": "v1: drift medido por símbolo vs objetivo del sleeve largo."
        },
        "rebalance_rule": {
          "type": "string",
          "minLength": 1,
          "description": "Regla inequívoca de día de revisión mensual (v1: primer día de sesión US del mes)."
        },
        "max_long_rebalance_turnover_pct": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "Tope opcional a sum(|Δw|) al escalar el rebalanceo dentro del sleeve largo."
        },
        "satellite_markets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["US"] }
        },
        "core_lines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "target_weight"],
            "properties": {
              "symbol": { "type": "string", "minLength": 1 },
              "target_weight": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "satellite_lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "target_weight"],
            "properties": {
              "symbol": { "type": "string", "minLength": 1 },
              "target_weight": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "satellite_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_satellite_weight_total",
            "max_weight_per_satellite_line",
            "max_satellite_names"
          ],
          "properties": {
            "max_satellite_weight_total": { "type": "number", "minimum": 0, "maximum": 1 },
            "max_weight_per_satellite_line": { "type": "number", "minimum": 0, "maximum": 1 },
            "max_satellite_names": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "short_term_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "momentum_lookback_days",
        "liquidity_percentile_min",
        "volatility_20d_max",
        "top_k_per_market",
        "risk_budget_trade_pct",
        "allow_leverage"
      ],
      "properties": {
        "momentum_lookback_days": { "type": "integer", "minimum": 1 },
        "liquidity_percentile_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "volatility_20d_max": { "type": "number", "minimum": 0 },
        "top_k_per_market": { "type": "integer", "minimum": 1 },
        "risk_budget_trade_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "allow_leverage": { "type": "boolean" }
      }
    },
    "markets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["US", "AR"],
      "properties": {
        "US": { "$ref": "#/$defs/marketCosts" },
        "AR": { "$ref": "#/$defs/marketCosts" }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "structured"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
        },
        "structured": { "type": "boolean" }
      }
    },
    "data_providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["us_ohlcv", "ar_ohlcv"],
      "properties": {
        "us_ohlcv": { "type": "string", "minLength": 1 },
        "ar_ohlcv": { "type": "string", "minLength": 1 }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_of_truth", "us_market_code", "ar_market_code"],
      "properties": {
        "source_of_truth": { "type": "string", "minLength": 1 },
        "us_market_code": { "type": "string", "minLength": 1 },
        "ar_market_code": { "type": "string", "minLength": 1 }
      }
    },
    "corporate_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["us_file", "supported_types"],
      "properties": {
        "us_file": { "type": "string", "minLength": 1 },
        "supported_types": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["split", "dividend"]
          }
        }
      }
    },
    "validation_wf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lookback_trading_days"],
      "properties": {
        "lookback_trading_days": {
          "type": "integer",
          "minimum": 20,
          "maximum": 500,
          "description": "Ventana histórica en días hábiles para el workflow de validación pre-live."
        }
      }
    },
    "short_term_pre_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "walk_forward", "thresholds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "walk_forward": {
          "type": "object",
          "additionalProperties": false,
          "required": ["oos_trading_days", "step_trading_days", "min_oos_windows"],
          "properties": {
            "oos_trading_days": { "type": "integer", "minimum": 3 },
            "step_trading_days": { "type": "integer", "minimum": 1 },
            "min_oos_windows": { "type": "integer", "minimum": 1 }
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "monthly_short_drawdown_floor",
            "max_fee_pct_of_initial_per_window",
            "max_turnover_annualized"
          ],
          "properties": {
            "monthly_short_drawdown_floor": {
              "type": ["number", "null"],
              "maximum": 0
            },
            "max_fee_pct_of_initial_per_window": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max_turnover_annualized": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "$defs": {
    "marketCosts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commission_bps_per_side", "slippage_bps"],
      "properties": {
        "commission_bps_per_side": { "type": "number", "minimum": 0 },
        "slippage_bps": { "type": "number", "minimum": 0 }
      }
    }
  }
}
